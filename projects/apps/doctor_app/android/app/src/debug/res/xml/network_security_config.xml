<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override: production base config stays cleartext=false
  (see src/main/res/xml/network_security_config.xml); this variant adds
  cleartext exceptions ONLY for the local dev backend reachable from the
  Android emulator (10.0.2.2) and localhost.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

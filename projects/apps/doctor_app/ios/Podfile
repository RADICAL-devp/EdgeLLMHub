# Uncomment this line to define a global platform for your project
# Minimum iOS 15.0 required for Metal GPU support (MLC LLM on-device inference)
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    # Force every pod target up to the project's minimum deployment target
    # (15.0) so plugins that require iOS >=14 (e.g. workmanager_apple) and
    # Metal (MLC LLM) don't hit "target supports 13.0" mismatches.
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Patch FlutterGeneratedPluginSwiftPackage/Package.swift to use the
  # project's iOS deployment target instead of Flutter's hardcoded 13.0/14.0.
  # This is required because some plugins (e.g. workmanager_apple) declare a
  # minimum platform higher than what the Flutter tool emits.
  generated_pkg = File.expand_path('Flutter/ephemeral/Packages/FlutterGeneratedPluginSwiftPackage/Package.swift', __dir__)
  if File.exist?(generated_pkg)
    contents = File.read(generated_pkg)
    podfile_platform = '15.0'
    # Raise ANY emitted iOS platform below the project's minimum to
    # podfile_platform. Flutter 3.44 hardcodes 13.0 when regenerating the
    # manifest on `flutter pub get`; without this, a direct Xcode build after
    # pub get fails package resolution for plugins that require iOS >= 14
    # (e.g. workmanager_apple, which needs 14.0).
    patched = contents.gsub(/\.iOS\("[0-9]+\.[0-9]+"\)/, ".iOS(\"#{podfile_platform}\")")
    File.write(generated_pkg, patched) if patched != contents
  end
end
